{
  "info": {
    "name": "Task 5.5 - User Reporting System",
    "description": "Complete test collection for User Reporting endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseURL",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "reportedUserId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get Report Reasons",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/reports/reasons",
          "host": ["{{baseURL}}"],
          "path": ["reports", "reasons"]
        },
        "description": "Get list of all report categories with descriptions"
      },
      "response": []
    },
    {
      "name": "2. Get Report Reasons (Alt Endpoint)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/master/report-reasons",
          "host": ["{{baseURL}}"],
          "path": ["master", "report-reasons"]
        },
        "description": "Alternative endpoint for report reasons via master data"
      },
      "response": []
    },
    {
      "name": "3. Create Report - FAKE_PROFILE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"FAKE_PROFILE\",\n  \"reason\": \"This user is using stolen photos and fake information. The profile details are completely inconsistent and appear to be fraudulent.\"\n}"
        },
        "url": {
          "raw": "{{baseURL}}/reports/{{reportedUserId}}",
          "host": ["{{baseURL}}"],
          "path": ["reports", "{{reportedUserId}}"]
        },
        "description": "Submit a report for fake profile"
      },
      "response": []
    },
    {
      "name": "4. Create Report - HARASSMENT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"HARASSMENT\",\n  \"reason\": \"This user has been sending threatening and harassing messages repeatedly over the past week. The behavior is unacceptable.\"\n}"
        },
        "url": {
          "raw": "{{baseURL}}/reports/{{reportedUserId}}",
          "host": ["{{baseURL}}"],
          "path": ["reports", "{{reportedUserId}}"]
        },
        "description": "Submit a report for harassment"
      },
      "response": []
    },
    {
      "name": "5. Create Report - SPAM",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"SPAM\",\n  \"reason\": \"This user is constantly sending spam messages promoting external services and websites.\"\n}"
        },
        "url": {
          "raw": "{{baseURL}}/reports/{{reportedUserId}}",
          "host": ["{{baseURL}}"],
          "path": ["reports", "{{reportedUserId}}"]
        },
        "description": "Submit a report for spam"
      },
      "response": []
    },
    {
      "name": "6. View My Reports - All",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/reports/my-reports?type=all&page=1&limit=20",
          "host": ["{{baseURL}}"],
          "path": ["reports", "my-reports"],
          "query": [
            {
              "key": "type",
              "value": "all"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Get all reports (made by me and against me)"
      },
      "response": []
    },
    {
      "name": "7. View My Reports - Made By Me",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/reports/my-reports?type=made&page=1&limit=20",
          "host": ["{{baseURL}}"],
          "path": ["reports", "my-reports"],
          "query": [
            {
              "key": "type",
              "value": "made"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Get only reports I submitted"
      },
      "response": []
    },
    {
      "name": "8. View My Reports - Against Me",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/reports/my-reports?type=received&page=1&limit=20",
          "host": ["{{baseURL}}"],
          "path": ["reports", "my-reports"],
          "query": [
            {
              "key": "type",
              "value": "received"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Get only reports filed against me"
      },
      "response": []
    },
    {
      "name": "9. View My Reports - Filter by Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/reports/my-reports?status=OPEN&type=all",
          "host": ["{{baseURL}}"],
          "path": ["reports", "my-reports"],
          "query": [
            {
              "key": "status",
              "value": "OPEN"
            },
            {
              "key": "type",
              "value": "all"
            }
          ]
        },
        "description": "Filter reports by OPEN status"
      },
      "response": []
    },
    {
      "name": "10. View My Reports - Filter by Category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/reports/my-reports?category=FAKE_PROFILE&type=all",
          "host": ["{{baseURL}}"],
          "path": ["reports", "my-reports"],
          "query": [
            {
              "key": "category",
              "value": "FAKE_PROFILE"
            },
            {
              "key": "type",
              "value": "all"
            }
          ]
        },
        "description": "Filter reports by FAKE_PROFILE category"
      },
      "response": []
    },
    {
      "name": "11. VALIDATION - Self Report (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"HARASSMENT\",\n  \"reason\": \"Testing self-report validation - this should fail\"\n}"
        },
        "url": {
          "raw": "{{baseURL}}/reports/YOUR_OWN_USER_ID",
          "host": ["{{baseURL}}"],
          "path": ["reports", "YOUR_OWN_USER_ID"]
        },
        "description": "Expected: 400 - Cannot report yourself"
      },
      "response": []
    },
    {
      "name": "12. VALIDATION - Short Reason (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"SPAM\",\n  \"reason\": \"Too short\"\n}"
        },
        "url": {
          "raw": "{{baseURL}}/reports/{{reportedUserId}}",
          "host": ["{{baseURL}}"],
          "path": ["reports", "{{reportedUserId}}"]
        },
        "description": "Expected: 400 - Reason must be at least 10 characters"
      },
      "response": []
    },
    {
      "name": "13. VALIDATION - Invalid Category (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"INVALID_CATEGORY\",\n  \"reason\": \"Testing invalid category validation\"\n}"
        },
        "url": {
          "raw": "{{baseURL}}/reports/{{reportedUserId}}",
          "host": ["{{baseURL}}"],
          "path": ["reports", "{{reportedUserId}}"]
        },
        "description": "Expected: 400 - Invalid category"
      },
      "response": []
    },
    {
      "name": "14. VALIDATION - Missing Reason (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"SPAM\"\n}"
        },
        "url": {
          "raw": "{{baseURL}}/reports/{{reportedUserId}}",
          "host": ["{{baseURL}}"],
          "path": ["reports", "{{reportedUserId}}"]
        },
        "description": "Expected: 400 - Reason is required"
      },
      "response": []
    },
    {
      "name": "15. VALIDATION - Invalid User ID (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"SPAM\",\n  \"reason\": \"Testing with non-existent user ID\"\n}"
        },
        "url": {
          "raw": "{{baseURL}}/reports/00000000-0000-0000-0000-000000000000",
          "host": ["{{baseURL}}"],
          "path": ["reports", "00000000-0000-0000-0000-000000000000"]
        },
        "description": "Expected: 404 - User not found"
      },
      "response": []
    }
  ]
}
