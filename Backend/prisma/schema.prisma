generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id               Int              @id @default(autoincrement())
  role_name        String           @unique @db.VarChar(50)
  description      String?
  role_permissions RolePermission[]
  users            User[]

  @@map("roles")
}

model Permission {
  id               Int              @id @default(autoincrement())
  permission_name  String           @unique @db.VarChar(100)
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  permission    Permission @relation(fields: [permission_id], references: [id])
  role          Role       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  id                            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id                       Int
  full_name                     String                   @db.VarChar(150)
  gender                        String                   @db.VarChar(10)
  date_of_birth                 DateTime                 @db.Date
  mobile_number                 String                   @unique @db.VarChar(15)
  email                         String?                  @unique @db.VarChar(150)
  password_hash                 String
  profile_created_by            String                   @db.VarChar(20)
  is_mobile_verified            Boolean                  @default(false)
  is_email_verified             Boolean                  @default(false)
  is_profile_verified           Boolean                  @default(false)
  is_active                     Boolean                  @default(true)
  created_at                    DateTime                 @default(now())
  updated_at                    DateTime                 @default(now()) @updatedAt
  highest_qualification         String?                  @db.VarChar(150)
  profile_completion_percentage Int?                     @default(0)
  profile_id                    String?                  @unique @db.VarChar(20)
  last_active_at                DateTime?
  profile_views_count           Int?                     @default(0)
  shortlist_count               Int?                     @default(0)
  shortlisted_by_count          Int?                     @default(0)
  is_flagged                    Boolean                  @default(false)
  moderation_flags              Json?
  audit_logs                    AuditLog[]
  feature_restrictions          UserFeatureRestriction[]
  interests_received            Interest[]               @relation("InterestReceiver")
  interests_sent                Interest[]               @relation("InterestSender")
  matched_with                  Match[]                  @relation("MatchedWith")
  matches_for                   Match[]                  @relation("MatchesFor")
  messages_received             Message[]                @relation("MessageReceiver")
  messages_sent                 Message[]                @relation("MessageSender")
  notifications_related         Notification[]           @relation("NotificationRelatedUser")
  notifications                 Notification[]           @relation("NotificationRecipient")
  otp_logs                      OtpLog[]
  partner_preferences           PartnerPreferences?
  profile_views_received        ProfileView[]            @relation("ProfileViewed")
  profile_views_made            ProfileView[]            @relation("ProfileViewer")
  refresh_tokens                RefreshToken[]
  search_logs                   SearchLog[]
  shortlisted_by                ShortlistedProfile[]     @relation("Shortlisted")
  shortlisted                   ShortlistedProfile[]     @relation("ShortlistedBy")
  subscriptions                 Subscription[]
  blocks_received               UserBlock[]              @relation("Blocked")
  blocks_made                   UserBlock[]              @relation("Blocker")
  caste_details                 UserCasteDetails?
  education_details             UserEducationDetails[]
  family_details                UserFamilyDetails?
  horoscope_details             UserHoroscopeDetails?
  personal_details              UserPersonalDetails?
  approved_photos               UserPhoto[]              @relation("PhotoApprover")
  photos                        UserPhoto[]
  professional_details          UserProfessionalDetails?
  reports_made                  UserReport[]             @relation("Reporter")
  reports_received              UserReport[]             @relation("Reported")
  reports_resolved              UserReport[]             @relation("ReportResolver")
  report_actions_made           ReportActionLog[]        @relation("ReportActionActor")
  report_actions_received       ReportActionLog[]        @relation("ReportActionTarget")
  feature_usage                 FeatureUsage[]
  role                          Role                     @relation(fields: [role_id], references: [id])

  @@index([profile_completion_percentage], map: "idx_users_profile_completion")
  @@index([last_active_at], map: "idx_users_last_active")
  @@index([gender, is_active, is_profile_verified], map: "idx_users_matchmaking")
  @@map("users")
}

model OtpLog {
  id         Int       @id @default(autoincrement())
  user_id    String?   @db.Uuid
  otp_code   String?   @db.VarChar(10)
  purpose    String?   @db.VarChar(30)
  expires_at DateTime?
  verified   Boolean   @default(false)
  user       User?     @relation(fields: [user_id], references: [id])

  @@map("otp_logs")
}

model RefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  is_revoked Boolean  @default(false)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@map("refresh_tokens")
}

model Religion {
  id            Int                @id @default(autoincrement())
  religion_name String             @unique @db.VarChar(100)
  is_active     Boolean            @default(true)
  castes        Caste[]
  caste_details UserCasteDetails[]

  @@map("religions")
}

model Caste {
  id            Int                @id @default(autoincrement())
  religion_id   Int
  caste_name    String             @db.VarChar(150)
  is_active     Boolean            @default(true)
  religion      Religion           @relation(fields: [religion_id], references: [id])
  sub_castes    SubCaste[]
  caste_details UserCasteDetails[]

  @@unique([religion_id, caste_name])
  @@map("castes")
}

model SubCaste {
  id             Int                @id @default(autoincrement())
  caste_id       Int
  sub_caste_name String?            @db.VarChar(150)
  is_active      Boolean            @default(true)
  caste          Caste              @relation(fields: [caste_id], references: [id])
  caste_details  UserCasteDetails[]

  @@unique([caste_id, sub_caste_name])
  @@map("sub_castes")
}

model UserPersonalDetails {
  user_id         String   @id @db.Uuid
  height_cm       Int?
  weight_kg       Int?
  marital_status  String?  @db.VarChar(30)
  physical_status String?  @db.VarChar(50)
  mother_tongue   String?  @db.VarChar(50)
  about_me        String?
  blood_group     String?  @db.VarChar(10)
  body_type       String?  @db.VarChar(30)
  complexion      String?  @db.VarChar(30)
  created_at      DateTime @default(now())
  diet_preference String?  @db.VarChar(30)
  drinking_habit  String?  @db.VarChar(30)
  smoking_habit   String?  @db.VarChar(30)
  updated_at      DateTime @default(now()) @updatedAt
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_personal_details")
}

model UserCasteDetails {
  user_id           String    @id @db.Uuid
  religion_id       Int?
  caste_id          Int?
  sub_caste_id      Int?
  community_details String?
  caste             Caste?    @relation(fields: [caste_id], references: [id])
  religion          Religion? @relation(fields: [religion_id], references: [id])
  sub_caste         SubCaste? @relation(fields: [sub_caste_id], references: [id])
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_caste_details")
}

model UserEducationDetails {
  id               Int     @id @default(autoincrement())
  user_id          String  @db.Uuid
  institution_name String? @db.VarChar(200)
  year_of_passing  Int?
  qualification    String? @db.VarChar(150)
  user             User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_education_details")
}

model UserProfessionalDetails {
  user_id             String   @id @db.Uuid
  occupation          String?  @db.VarChar(150)
  employment_type     String?  @db.VarChar(100)
  company_name        String?  @db.VarChar(200)
  annual_income_range String?  @db.VarChar(50)
  created_at          DateTime @default(now())
  designation         String?  @db.VarChar(150)
  updated_at          DateTime @default(now()) @updatedAt
  years_of_experience Int?
  work_city           String?  @db.VarChar(100)
  work_location_type  String?  @db.VarChar(50)
  work_state          String?  @db.VarChar(100)
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_professional_details")
}

model UserFamilyDetails {
  user_id           String  @id @db.Uuid
  father_occupation String? @db.VarChar(150)
  mother_occupation String? @db.VarChar(150)
  siblings_details  String?
  family_values     String? @db.VarChar(100)
  user              User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_family_details")
}

model UserHoroscopeDetails {
  user_id        String    @id @db.Uuid
  rasi           String?   @db.VarChar(50)
  nakshatra      String?   @db.VarChar(50)
  time_of_birth  DateTime? @db.Time(6)
  place_of_birth String?   @db.VarChar(150)
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_horoscope_details")
}

model UserPhoto {
  id          Int      @id @default(autoincrement())
  user_id     String   @db.Uuid
  photo_url   String
  visibility  String?  @default("PUBLIC") @db.VarChar(20)
  is_approved Boolean  @default(false)
  approved_by String?  @db.Uuid
  uploaded_at DateTime @default(now())
  is_primary  Boolean  @default(false)
  approver    User?    @relation("PhotoApprover", fields: [approved_by], references: [id])
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_primary])
  @@map("user_photos")
}

model PartnerPreferences {
  user_id                    String   @id @db.Uuid
  min_age                    Int?
  max_age                    Int?
  min_height                 Int?
  max_height                 Int?
  created_at                 DateTime @default(now())
  diet_preference            String[] @default([])
  drinking_habit_preference  String[] @default([])
  income_preference_max      String?
  income_preference_min      String?
  marital_status_preference  String[] @default([])
  mother_tongue_preference   String[] @default([])
  smoking_habit_preference   String[] @default([])
  updated_at                 DateTime @default(now()) @updatedAt
  religion_preference        Int[]    @default([])
  caste_preference           Int[]    @default([])
  education_preference       String[] @default([])
  max_weight                 Int?
  min_weight                 Int?
  physical_status            String[] @default([])
  preferred_location         Json?
  employment_type_preference String[] @default([])
  user                       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("partner_preferences")
}

model ShortlistedProfile {
  user_id             String   @db.Uuid
  shortlisted_user_id String   @db.Uuid
  created_at          DateTime @default(now())
  shortlisted_user    User     @relation("Shortlisted", fields: [shortlisted_user_id], references: [id])
  user                User     @relation("ShortlistedBy", fields: [user_id], references: [id])

  @@id([user_id, shortlisted_user_id])
  @@map("shortlisted_profiles")
}

model SearchLog {
  id                Int           @id @default(autoincrement())
  user_id           String?       @db.Uuid
  search_filters    Json
  searched_at       DateTime      @default(now())
  result_count      Int           @default(0)
  execution_time_ms Int           @default(0)
  ip_address        String?       @db.VarChar(45)
  user_agent        String?
  profile_views     ProfileView[]
  user              User?         @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([searched_at])
  @@map("search_logs")
}

model Interest {
  id           Int            @id @default(autoincrement())
  sender_id    String         @db.Uuid
  receiver_id  String         @db.Uuid
  sent_at      DateTime       @default(now())
  responded_at DateTime?
  updated_at   DateTime       @default(now()) @updatedAt
  status       InterestStatus @default(PENDING)
  receiver     User           @relation("InterestReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  sender       User           @relation("InterestSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@unique([sender_id, receiver_id])
  @@index([sender_id, status])
  @@index([receiver_id, status])
  @@index([sent_at])
  @@map("interests")
}

model Message {
  sender_id               String    @db.Uuid
  receiver_id             String    @db.Uuid
  sent_at                 DateTime  @default(now())
  id                      Int       @id @default(autoincrement())
  content                 String    @db.VarChar(1000)
  deleted_by_receiver_at  DateTime?
  deleted_by_sender_at    DateTime?
  read_at                 DateTime?
  archived_by_sender_at   DateTime?
  archived_by_receiver_at DateTime?
  receiver                User      @relation("MessageReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  sender                  User      @relation("MessageSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([sender_id, sent_at])
  @@index([receiver_id, read_at])
  @@index([sender_id, receiver_id, sent_at])
  @@map("messages")
}

model UserReport {
  id            Int            @id @default(autoincrement())
  reported_by   String         @db.Uuid
  reported_user String         @db.Uuid
  category      ReportCategory
  reason        String?
  severity      ReportSeverity @default(MEDIUM)
  status        ReportStatus   @default(OPEN)
  action_taken  ReportAction?
  admin_notes   String?
  resolved_by   String?        @db.Uuid
  resolved_at   DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  actions       ReportActionLog[]
  reporter      User           @relation("Reporter", fields: [reported_by], references: [id])
  reported      User           @relation("Reported", fields: [reported_user], references: [id])
  resolver      User?          @relation("ReportResolver", fields: [resolved_by], references: [id])

  @@index([status, severity, created_at])
  @@index([reported_user, status])
  @@index([reported_by])
  @@index([created_at])
  @@map("user_reports")
}

model ReportActionLog {
  id          Int          @id @default(autoincrement())
  report_id   Int
  user_id     String       @db.Uuid
  action      ReportAction
  metadata    Json?
  acted_by    String       @db.Uuid
  created_at  DateTime     @default(now())
  report      UserReport   @relation(fields: [report_id], references: [id], onDelete: Cascade)
  actor       User         @relation("ReportActionActor", fields: [acted_by], references: [id])
  target_user User         @relation("ReportActionTarget", fields: [user_id], references: [id])

  @@index([report_id, created_at])
  @@index([user_id])
  @@index([acted_by])
  @@map("report_action_logs")
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  actor_id        String?  @db.Uuid
  target_user_id  String?  @db.Uuid
  action_type     String   @db.VarChar(50)  // ADMIN_ACTION, USER_ACTION, SYSTEM_ACTION, AUTH_EVENT
  action          String   @db.VarChar(255) // Detailed action description
  resource_type   String?  @db.VarChar(50)  // USER, PHOTO, REPORT, SUBSCRIPTION, etc.
  resource_id     String?  @db.VarChar(100) // ID of affected resource
  metadata        Json?    // Additional context (reason, old/new values, etc.) - PII masked
  ip_address      String?  @db.VarChar(45)
  user_agent      String?  @db.VarChar(500)
  status          String   @default("SUCCESS") @db.VarChar(20) // SUCCESS, FAILURE, PARTIAL
  created_at      DateTime @default(now())
  actor           User?    @relation(fields: [actor_id], references: [id])

  @@index([actor_id, created_at])
  @@index([target_user_id, created_at])
  @@index([action_type, created_at])
  @@index([resource_type, resource_id])
  @@index([created_at])
  @@map("audit_logs")
}

model SubscriptionPlan {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String         @db.VarChar(50)
  display_name       String         @db.VarChar(100)
  description        String?
  price_amount       Int            // Stored in paise (₹1 = 100 paise)
  currency           String         @default("INR") @db.VarChar(3)
  billing_cycle      String         @default("MONTHLY") @db.VarChar(20)
  duration_days      Int            // Duration in days (30, 90, 365)
  priority           Int            @default(0) // 0=Free, 1=Basic, 2=Premium, 3=Gold
  trial_period_days  Int?           // Trial period in days (7, 14, 30)
  is_active          Boolean        @default(true)
  version            Int            @default(1) // Plan versioning for immutability
  parent_plan_id     String?        @db.Uuid // Reference to original plan for versioning
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  deactivated_at     DateTime?
  deactivated_by     String?        @db.Uuid
  
  parent_plan        SubscriptionPlan?  @relation("PlanVersions", fields: [parent_plan_id], references: [id])
  plan_versions      SubscriptionPlan[] @relation("PlanVersions")
  plan_features      PlanFeature[]
  subscriptions      Subscription[]
  
  @@unique([code, version])
  @@index([code, is_active])
  @@index([priority, is_active])
  @@index([is_active, billing_cycle])
  @@map("subscription_plans")
}

model Feature {
  id             Int           @id @default(autoincrement())
  code           String        @unique @db.VarChar(50)
  display_name   String        @db.VarChar(100)
  description    String?
  value_type     String        @default("BOOLEAN") @db.VarChar(20)
  reset_period   String        @default("NONE") @db.VarChar(20)
  is_active      Boolean       @default(true)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  
  plan_features  PlanFeature[]
  feature_usage  FeatureUsage[]
  
  @@index([code, is_active])
  @@map("features")
}

model PlanFeature {
  id                 Int              @id @default(autoincrement())
  plan_id            String           @db.Uuid
  feature_id         Int
  is_enabled         Boolean          @default(true)
  value_number       Int?             // For numeric limits (e.g., 5, 50, -1 for unlimited)
  value_string       String?          @db.VarChar(50) // For string values (e.g., "unlimited", "priority")
  value_boolean      Boolean?         // For boolean features
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  
  plan               SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  feature            Feature          @relation(fields: [feature_id], references: [id], onDelete: Cascade)
  
  @@unique([plan_id, feature_id])
  @@index([plan_id, feature_id])
  @@map("plan_features")
}

model FeatureUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  feature_id     Int
  used_count     Int      @default(0)
  window_start   DateTime
  window_end     DateTime
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  feature        Feature  @relation(fields: [feature_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, feature_id, window_start])
  @@index([user_id, feature_id, window_end])
  @@index([window_end]) // For cleanup jobs
  @@map("feature_usage")
}

model Subscription {
  id                Int                 @id @default(autoincrement())
  user_id           String              @db.Uuid
  plan_id           String?             @db.Uuid // Nullable for migration
  plan_name         String?             @db.VarChar(50) // Legacy field, will be removed
  status            String              @default("ACTIVE") @db.VarChar(30)
  start_date        DateTime?           @db.Date
  end_date          DateTime?           @db.Date
  trial_end_date    DateTime?           @db.Date
  is_active         Boolean             @default(true) // Legacy field
  auto_renew        Boolean             @default(false)
  cancelled_at      DateTime?
  cancelled_by      String?             @db.Uuid
  cancellation_reason String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  
  user              User                @relation(fields: [user_id], references: [id])
  plan              SubscriptionPlan?   @relation(fields: [plan_id], references: [id])
  
  @@index([user_id, status])
  @@index([plan_id, status])
  @@index([end_date])
  @@index([status, auto_renew, end_date])
  @@map("subscriptions")
}

model Match {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String             @db.Uuid
  matched_user_id String             @db.Uuid
  match_score     Float
  match_type      MatchType
  generated_at    DateTime           @default(now())
  expires_at      DateTime?
  interactions    MatchInteraction[]
  matched_user    User               @relation("MatchedWith", fields: [matched_user_id], references: [id], onDelete: Cascade)
  user            User               @relation("MatchesFor", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, matched_user_id, match_type])
  @@index([user_id, match_type])
  @@index([generated_at])
  @@index([expires_at])
  @@map("matches")
}

model MatchInteraction {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_id  String    @db.Uuid
  is_viewed Boolean   @default(false)
  viewed_at DateTime?
  action    String?   @db.VarChar(20)
  acted_at  DateTime?
  match     Match     @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@index([match_id])
  @@map("match_interactions")
}

model ProfileView {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewer_id             String     @db.Uuid
  viewed_user_id        String     @db.Uuid
  viewed_at             DateTime   @default(now())
  view_source           ViewSource @default(DIRECT)
  view_duration_seconds Int?
  search_log_id         Int?
  ip_address            String?    @db.VarChar(45)
  user_agent            String?
  search_log            SearchLog? @relation(fields: [search_log_id], references: [id])
  viewed_user           User       @relation("ProfileViewed", fields: [viewed_user_id], references: [id], onDelete: Cascade)
  viewer                User       @relation("ProfileViewer", fields: [viewer_id], references: [id], onDelete: Cascade)

  @@index([viewed_user_id, viewed_at(sort: Desc)])
  @@index([viewer_id, viewed_at(sort: Desc)])
  @@index([viewer_id, viewed_user_id, viewed_at(sort: Desc)])
  @@index([view_source, viewed_at(sort: Desc)])
  @@index([search_log_id])
  @@map("profile_views")
}

model UserBlock {
  id           Int       @id @default(autoincrement())
  blocker_id   String    @db.Uuid
  blocked_id   String    @db.Uuid
  blocked_at   DateTime  @default(now())
  unblocked_at DateTime?
  blocked      User      @relation("Blocked", fields: [blocked_id], references: [id], onDelete: Cascade)
  blocker      User      @relation("Blocker", fields: [blocker_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
  @@index([unblocked_at])
  @@map("user_blocks")
}

model Notification {
  id              Int              @id @default(autoincrement())
  user_id         String           @db.Uuid
  type            NotificationType
  title           String           @db.VarChar(200)
  message         String?
  is_read         Boolean          @default(false)
  related_user_id String?          @db.Uuid
  related_id      Int?
  created_at      DateTime         @default(now())
  read_at         DateTime?
  related_user    User?            @relation("NotificationRelatedUser", fields: [related_user_id], references: [id])
  user            User             @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([user_id, created_at(sort: Desc)])
  @@index([created_at])
  @@map("notifications")
}

enum MatchType {
  DAILY_MATCH
  RECOMMENDATION
  NEW_MATCH
}

enum ViewSource {
  SEARCH
  MATCH
  RECOMMENDATION
  DIRECT
  SHORTLIST
  INTEREST
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
  INTEREST_REJECTED
  MESSAGE_RECEIVED
  PROFILE_VIEW
  MATCH_FOUND
  NEW_REPORT
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTION_TAKEN
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportCategory {
  FAKE_PROFILE
  HARASSMENT
  INAPPROPRIATE_PHOTO
  INAPPROPRIATE_CONTENT
  SPAM
  SCAM
  UNDERAGE
  MARRIED
  DUPLICATE_PROFILE
  OFFENSIVE_BEHAVIOR
  OTHER
}

enum ReportAction {
  NO_ACTION
  WARN_USER
  SUSPEND_USER
  DEACTIVATE_USER
  DELETE_CONTENT
  RESTRICT_FEATURES
  FLAG_USER
}

enum RestrictedFeature {
  CHAT
  INTEREST
  UPLOAD
  SEARCH
}

model UserFeatureRestriction {
  id            Int                @id @default(autoincrement())
  user_id       String             @db.Uuid
  feature       RestrictedFeature
  restricted_at DateTime           @default(now())
  expires_at    DateTime?
  reason        String?
  restricted_by String             @db.Uuid
  updated_by    String?            @db.Uuid
  updated_at    DateTime?
  report_id     Int?
  is_active     Boolean            @default(true)
  user          User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, feature, is_active])
  @@index([user_id, feature, is_active, expires_at])
  @@map("user_feature_restrictions")
}
