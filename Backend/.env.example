# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://<username>:<password>@<host>:6543/<database>?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://<username>:<password>@<host>:5432/<database>"

# JWT Configuration
JWT_SECRET=""
JWT_EXPIRATION="24h"

# Admin Creation Secret - Change this to a strong secret key
# This is used to protect the /auth/create-admin endpoint
ADMIN_CREATION_SECRET=""

# Twilio Configuration (for OTP SMS)
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
SMS_TEST_MODE="true"

# Cron Jobs Configuration (Task 4.6)
# Set to 'true' ONLY on ONE instance to prevent duplicate notifications in multi-instance deployments
# In development, set to 'true' to test cron jobs locally
RUN_CRON_JOBS="false"

# Timezone for scheduled tasks (default: Asia/Kolkata)
# Use IANA timezone names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE="Asia/Kolkata"

# Notification retention period in days (default: 90)
# Old notifications will be auto-deleted after this many days
NOTIFICATION_RETENTION_DAYS="90"