# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://<username>:<password>@<host>:6543/<database>?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://<username>:<password>@<host>:5432/<database>"

# JWT Configuration
JWT_SECRET=""
JWT_EXPIRATION="24h"

# Admin Creation Secret - Change this to a strong secret key
# This is used to protect the /auth/create-admin endpoint
ADMIN_CREATION_SECRET=""

# Twilio Configuration (for OTP SMS)
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
SMS_TEST_MODE="true"